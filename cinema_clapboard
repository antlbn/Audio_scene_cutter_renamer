#!/usr/bin/env bash
set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ─────────────────────────────────────────────────────────────────────────────
# Subcommand passthrough
#
# Известные subcommand-ы передаются напрямую в Python без bash-трансляции.
# Argparse внутри cli.py разбирает всё сам.
#
# Пример: cinema-clapboard whisper audio.wav --language fr --translate --save
# ─────────────────────────────────────────────────────────────────────────────

KNOWN_SUBCOMMANDS=("whisper")

if [[ $# -gt 0 ]]; then
    for sub in "${KNOWN_SUBCOMMANDS[@]}"; do
        if [[ "$1" == "$sub" ]]; then
            exec uv run --project "$SCRIPT_DIR" python -m cinema_clapboard_app.cli "$@"
        fi
    done
fi

# ─────────────────────────────────────────────────────────────────────────────
# Основной режим (полный пайплайн)
# ─────────────────────────────────────────────────────────────────────────────

show_help() {
    echo "Usage: cinema_clapboard <audio_file_or_directory> [options]"
    echo "       cinema_clapboard whisper <audio_file> [options]"
    echo "       cinema_clapboard -settings"
    echo ""
    echo "Subcommands:"
    echo "  whisper <file>       Transcribe a file with Whisper (no CLAP / LLM)"
    echo "    --language CODE    Force source language (e.g. fr, de, ru)"
    echo "    --translate        Force translate mode (output always English)"
    echo "    --json             Print raw JSON to stdout"
    echo "    --save             Save result as {stem}_whisper.json next to the file"
    echo ""
    echo "Arguments:"
    echo "  <audio_file>         Process a single audio file (full pipeline)"
    echo "  <directory>          Scan directory recursively, select files via TUI"
    echo ""
    echo "Options:"
    echo "  -settings            Open the interactive settings UI"
    echo "  -rename              Rename the original file based on sequence/shot/take"
    echo "  -json                Print JSON to stdout"
    echo "  -save                Save result JSON next to the processed file"
    echo ""
    echo "Examples:"
    echo "  cinema_clapboard -settings"
    echo "  cinema_clapboard audio.wav -rename"
    echo "  cinema_clapboard ./recordings/ -rename -save"
    echo "  cinema_clapboard whisper audio.wav --language fr --translate --save"
    exit 0
}

# Parse options for the full pipeline mode
INPUT_PATH=""
RENAME=false
SAVE_JSON=false
SAVE=false

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            ;;
        -settings|--settings)
            exec uv run --project "$SCRIPT_DIR" python -m cinema_clapboard_app.cli --settings
            ;;
        -rename|--rename)
            RENAME=true
            shift
            ;;
        -json|--json|-save-json|--save-json)
            SAVE_JSON=true
            shift
            ;;
        -save|--save)
            SAVE=true
            shift
            ;;
        -*)
            echo "Unknown option: $1" >&2
            echo "Run 'cinema_clapboard --help' for usage." >&2
            exit 1
            ;;
        *)
            if [[ -z "$INPUT_PATH" ]]; then
                INPUT_PATH="$1"
            else
                echo "Error: Multiple positional arguments are not supported: $1" >&2
                echo "Run 'cinema_clapboard --help' for usage." >&2
                exit 1
            fi
            shift
            ;;
    esac
done

if [[ -z "$INPUT_PATH" ]]; then
    echo "Error: No file or directory specified." >&2
    echo "Run 'cinema_clapboard --help' for usage." >&2
    exit 1
fi

# Build python command options
ARGS=()

if [ "$RENAME" = true ]; then
    ARGS+=("--rename")
fi

if [ "$SAVE_JSON" = true ]; then
    ARGS+=("--json")
fi

if [ "$SAVE" = true ]; then
    ARGS+=("--save")
fi

# Run the unified orchestrator inside the virtual environment using uv run.
# SCRIPT_DIR ensures this works when called from any directory.
exec uv run --project "$SCRIPT_DIR" python -m cinema_clapboard_app.cli "$INPUT_PATH" "${ARGS[@]}"
